# ---------------------------------------------------------------------------
# ESCA Estate Marketplace - Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
PORT=3000

# Public origin the API is reachable on. Used to build absolute image URLs when
# Cloudinary is not configured (local-disk fallback). Defaults to http://localhost:PORT.
APP_URL=http://localhost:3000

# Comma-separated list of allowed browser origins for CORS.
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/esca_estate?schema=public

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Security ---
BCRYPT_SALT_ROUNDS=12
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Cloudinary (image storage) ---
# Leave blank to fall back to local disk storage under ./uploads (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Uploads ---
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=10

# --- Seed (development only) ---
# Passwords used by `npm run prisma:seed`. Seeding aborts if NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@esca-estate.com
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_USER_PASSWORD=
