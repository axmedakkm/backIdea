// ===========================================================================
//  ESCA Estate Marketplace - Prisma schema
//  Database: PostgreSQL
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
//  Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  AGENT
  ADMIN
}

enum PropertyPurpose {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SOLD
  RENTED
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  TOWNHOUSE
  OFFICE
  COMMERCIAL
  LAND
  SHOP
  WAREHOUSE
}

enum PricePeriod {
  ONE_TIME
  MONTHLY
  YEARLY
  WEEKLY
  DAILY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
}

enum NotificationType {
  NEW_MESSAGE
  NEW_APPOINTMENT
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  NEW_REVIEW
  PROPERTY_FAVORITED
}

enum ReportTargetType {
  PROPERTY
  AGENT
  USER
  REVIEW
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

// ---------------------------------------------------------------------------
//  Identity
// ---------------------------------------------------------------------------

model User {
  id       String   @id @default(uuid()) @db.Uuid
  email    String   @unique
  password String
  name     String
  phone    String?
  avatar   String?
  role     UserRole @default(USER)

  isEmailVerified Boolean @default(false)
  isActive        Boolean @default(true)

  // Hashed refresh token. Cleared on logout so the token can no longer be replayed.
  hashedRefreshToken String?

  // Hashed single-use tokens for out-of-band flows.
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  agent                   Agent?
  favorites               Favorite[]
  appointments            Appointment[]
  conversationParticipant ConversationParticipant[]
  messages                Message[]
  notifications           Notification[]
  reviewsWritten          Review[]                  @relation("ReviewAuthor")
  reportsFiled            Report[]                  @relation("ReportReporter")
  reportsResolved         Report[]                  @relation("ReportResolver")

  @@index([role])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Agent {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  bio         String?
  company     String?
  licenseNo   String? @unique
  website     String?
  officePhone String?

  // Denormalised rating, recalculated whenever a review is written/edited/removed.
  rating        Float @default(0)
  reviewCount   Int   @default(0)
  propertyCount Int   @default(0)

  isVerified Boolean @default(false)

  locationId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  properties Property[]
  reviews    Review[]

  @@index([rating])
  @@index([isVerified])
  @@index([locationId])
  @@index([deletedAt])
  @@map("agents")
}

// ---------------------------------------------------------------------------
//  Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  properties Property[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

model Location {
  id        String  @id @default(uuid()) @db.Uuid
  country   String
  city      String
  district  String?
  address   String?
  slug      String  @unique
  latitude  Float?
  longitude Float?
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  properties Property[]
  agents     Agent[]

  @@unique([country, city, district], name: "country_city_district")
  @@index([country])
  @@index([city])
  @@index([district])
  @@index([deletedAt])
  @@map("locations")
}

// ---------------------------------------------------------------------------
//  Listings
// ---------------------------------------------------------------------------

model Property {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  slug        String @unique
  description String

  price       Decimal     @db.Decimal(14, 2)
  currency    String      @default("USD") @db.VarChar(3)
  pricePeriod PricePeriod @default(ONE_TIME)

  purpose      PropertyPurpose
  status       PropertyStatus  @default(DRAFT)
  propertyType PropertyType

  bedrooms      Int?
  bathrooms     Int?
  area          Float
  yearBuilt     Int?
  floor         Int?
  totalFloors   Int?
  parkingSpaces Int   @default(0)

  address   String
  city      String
  district  String?
  country   String
  latitude  Float?
  longitude Float?

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(false)
  isApproved  Boolean @default(false)

  viewCount Int @default(0)

  // Set by an admin when status becomes REJECTED.
  rejectionReason String?

  agentId    String  @db.Uuid
  categoryId String? @db.Uuid
  locationId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  images        PropertyImage[]
  features      PropertyFeature[]
  favorites     Favorite[]
  appointments  Appointment[]
  conversations Conversation[]

  // Composite indexes mirror the most common marketplace filter combinations.
  @@index([status, isPublished, deletedAt])
  @@index([purpose, propertyType, status])
  @@index([city, district])
  @@index([country])
  @@index([price])
  @@index([area])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([agentId])
  @@index([categoryId])
  @@index([locationId])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("properties")
}

model PropertyImage {
  id         String  @id @default(uuid()) @db.Uuid
  propertyId String  @db.Uuid
  url        String
  publicId   String?
  isPrimary  Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_images")
}

model PropertyFeature {
  id         String  @id @default(uuid()) @db.Uuid
  propertyId String  @db.Uuid
  name       String
  value      String?

  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("property_features")
}

model Favorite {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  propertyId String @db.Uuid

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
//  Scheduling
// ---------------------------------------------------------------------------

model Appointment {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  userId     String @db.Uuid

  scheduledAt  DateTime
  durationMin  Int               @default(60)
  status       AppointmentStatus @default(PENDING)
  note         String?
  /// Reason supplied when the appointment is cancelled.
  cancelReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([propertyId, status])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
//  Messaging
// ---------------------------------------------------------------------------

model Conversation {
  id         String  @id @default(uuid()) @db.Uuid
  /// Optional listing the conversation is about.
  propertyId String? @db.Uuid
  title      String?

  lastMessageAt DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  property     Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([propertyId])
  @@index([lastMessageAt])
  @@index([deletedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  userId         String @db.Uuid

  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  senderId       String @db.Uuid

  type     MessageType @default(TEXT)
  content  String
  /// Media URL for IMAGE / VOICE messages.
  mediaUrl String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([deletedAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
//  Engagement
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  type   NotificationType
  title  String
  body   String
  /// Free-form payload (e.g. `{ "propertyId": "..." }`) for frontend deep-linking.
  data   Json?
  isRead Boolean          @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Review {
  id       String @id @default(uuid()) @db.Uuid
  agentId  String @db.Uuid
  authorId String @db.Uuid

  rating  Int
  comment String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  agent  Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // One review per author per agent.
  @@unique([agentId, authorId])
  @@index([agentId])
  @@index([authorId])
  @@index([rating])
  @@index([deletedAt])
  @@map("reviews")
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @db.Uuid
  targetType ReportTargetType
  /// ID of the reported Property / Agent / User / Review.
  targetId   String           @db.Uuid

  reason      String
  description String?
  status      ReportStatus @default(PENDING)

  /// Admin note recorded when the report is actioned.
  resolutionNote String?
  resolvedById   String?   @db.Uuid
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  // A user may report a given target only once.
  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("reports")
}
